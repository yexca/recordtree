FROM ghcr.io/astral-sh/uv:0.13.5 AS uv

FROM node:24-bookworm

# uv installs the Python pinned in .python-version under /opt/uv-python and the
# environment under /opt/venv, outside the /workspace bind mount.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_NO_CACHE=1 \
    UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    PATH="/opt/venv/bin:${PATH}"

COPY --from=uv /uv /usr/local/bin/uv

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends wget ca-certificates procps \
    && wget -O /tmp/megacmd-Debian_12_amd64.deb https://mega.nz/linux/repo/Debian_12/amd64/megacmd-Debian_12_amd64.deb \
    && apt-get install -y --no-install-recommends /tmp/megacmd-Debian_12_amd64.deb \
    && rm -f /tmp/megacmd-Debian_12_amd64.deb \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock .python-version README.md LICENSE ./
COPY recordtree ./recordtree
RUN uv sync --locked --extra web

COPY web/package*.json ./web/
RUN cd web && npm ci

COPY . .

EXPOSE 7647 5173

CMD ["sleep", "infinity"]
